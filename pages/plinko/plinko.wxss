.plinko-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  background: #1a1a2e;
  overflow: hidden;
}

.plinko-canvas {
  width: 100%;
  height: 100%;
}

.power-indicator {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.power-bar {
  width: 30rpx;
  height: 300rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 15rpx;
  overflow: hidden;
  position: relative;
}

.power-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, #00ff88, #ffff00, #ff4444);
  border-radius: 15rpx;
  transition: height 0.05s;
}

.power-text {
  color: #fff;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.bottom-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
}

.config-btn {
  color: #00ff88;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border: 2rpx solid #00ff88;
  border-radius: 12rpx;
}

.result-display {
  display: flex;
  align-items: center;
}

.result-label {
  color: rgba(255,255,255,0.6);
  font-size: 24rpx;
}

.result-value {
  color: #ffd700;
  font-size: 30rpx;
  font-weight: bold;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  max-height: 70vh;
  background: #2a2a4a;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
}

.modal-close {
  color: rgba(255,255,255,0.5);
  font-size: 40rpx;
  padding: 10rpx;
}

.slot-list {
  max-height: 400rpx;
  margin-bottom: 30rpx;
}

.slot-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.slot-input {
  flex: 1;
  height: 72rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
  padding: 0 24rpx;
  color: #fff;
  font-size: 28rpx;
}

.slot-delete {
  color: #ff4444;
  font-size: 32rpx;
  padding: 10rpx 16rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-add {
  background: rgba(255,255,255,0.1);
  color: #fff;
}

.btn-save {
  background: #00ff88;
  color: #1a1a2e;
  font-weight: bold;
}
