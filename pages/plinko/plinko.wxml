<view class="plinko-container">
  <canvas type="2d" id="plinkoCanvas" class="plinko-canvas" 
    bindtouchstart="onTouchStart" 
    bindtouchmove="onTouchMove" 
    bindtouchend="onTouchEnd">
  </canvas>

  <view class="hit-counter" wx:if="{{isRunning || hitCount > 0}}">
    <text class="hit-count-number">{{hitCount}}</text>
    <text class="hit-count-label">碰撞</text>
  </view>

  <!-- power indicator -->
  <view class="power-indicator" wx:if="{{isCharging}}">
    <view class="power-bar">
      <view class="power-fill" style="height: {{powerPercent}}%"></view>
    </view>
    <text class="power-text">{{powerPercent}}%</text>
  </view>

  <!-- bottom bar -->
  <view class="bottom-bar">
    <view class="bottom-btns">
      <view class="slot-config" bindtap="goSlotConfig">
        <text class="config-btn">配置槽位</text>
      </view>
      <view class="slot-config" bindtap="resetPegs">
        <text class="reset-btn">重置钉子</text>
      </view>
    </view>
    <view class="result-display" wx:if="{{lastResult}}">
      <text class="result-label">上次结果：</text>
      <text class="result-value">{{lastResult}}</text>
    </view>
  </view>
</view>
