<view class="home-container">
  <view class="welcome-section">
    <text class="welcome-title">欢迎来到记录中心</text>
  </view>
  
  <view class="function-grid">
    <view class="function-card" bindtap="goToPokemon">
      <text class="card-icon-text">⚡</text>
      <text class="card-title">Pokémon</text>
      <text class="card-desc">对战分数记录</text>
    </view>
    
    <view class="function-card" bindtap="goToRecord">
      <text class="card-icon-text">📝</text>
      <text class="card-title">日常记录</text>
      <text class="card-desc">日常技能记录</text>
    </view>
  </view>
</view>