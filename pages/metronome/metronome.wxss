.metronome-container {
  padding: 20rpx 30rpx 100rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.back-home {
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.back-text {
  font-size: 28rpx;
  color: #4ecdc4;
  font-weight: bold;
}

/* 节拍显示卡片：左侧节拍信息 + 右侧播放按钮 */
.display-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.display-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 固定高度占位，圆圈缩放不影响卡片高度 */
.beat-circle-slot {
  height: 170rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.beat-circle {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4ecdc4 0%, #44a3a0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(78, 205, 196, 0.4);
  transition: width 0.15s ease, height 0.15s ease;
}

.beat-circle.accent {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a3a0 100%);
  box-shadow: 0 10rpx 30rpx rgba(78, 205, 196, 0.4);
}

/* 剩余拍：黄色，尺寸略小 */
.beat-circle.weak {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #f7b731 0%, #e0a32e 100%);
  box-shadow: 0 10rpx 30rpx rgba(247, 183, 49, 0.4);
}

/* 通过交替动画类重启脉冲动画 */
@keyframes pulse-a {
  0% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

@keyframes pulse-b {
  0% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

.beat-circle.pulse-a {
  animation: pulse-a 0.12s ease-out;
}

.beat-circle.pulse-b {
  animation: pulse-b 0.12s ease-out;
}

.beat-number {
  font-size: 60rpx;
  font-weight: bold;
  color: white;
  transition: font-size 0.15s ease;
}

/* 强拍圆圈更大，数字同步放大 */
.beat-circle.accent .beat-number {
  font-size: 76rpx;
}

/* 弱拍圆圈更小，数字同步缩小 */
.beat-circle.weak .beat-number {
  font-size: 54rpx;
}

/* 待机时的音符图标放大 */
.beat-number.note {
  font-size: 90rpx;
  font-weight: normal;
}

.bpm-display {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.bpm-value {
  font-size: 60rpx;
  font-weight: bold;
  color: #333;
}

.bpm-unit {
  font-size: 28rpx;
  color: #888;
  margin-left: 10rpx;
}

.beat-dots {
  display: flex;
  justify-content: center;
}

.beat-dot + .beat-dot {
  margin-left: 20rpx;
}

.beat-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #e0e0e0;
  transition: all 0.1s ease;
}

.beat-dot.dot-active {
  background: #f7b731;
  transform: scale(1.4);
}

.beat-dot.dot-active-accent {
  background: #4ecdc4;
  transform: scale(1.4);
}

/* 控制卡片通用样式 */
.control-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

/* BPM调节 */
.bpm-adjust {
  display: flex;
  align-items: center;
}

.adjust-btn {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #4ecdc4;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.adjust-btn:active {
  opacity: 0.8;
}

.slider-wrapper {
  flex: 1;
  margin: 0 10rpx;
}

.tempo-mark {
  text-align: center;
  margin-top: 10rpx;
}

.tempo-text {
  font-size: 26rpx;
  color: #888;
}

/* 拍号选择 */
.beats-options {
  display: flex;
  margin-bottom: 20rpx;
}

.beats-option + .beats-option {
  margin-left: 20rpx;
}

.beats-option {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.beats-option.beats-active {
  background: #4ecdc4;
  color: white;
  font-weight: bold;
}

.beats-hint {
  font-size: 24rpx;
  color: #aaa;
}

/* 反馈开关 */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.switch-row:last-child {
  margin-bottom: 0;
}

.switch-label {
  font-size: 30rpx;
  color: #333;
}

/* 播放/停止圆形按钮（显示卡片右侧） */
.play-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4ecdc4 0%, #44a3a0 100%);
  box-shadow: 0 10rpx 30rpx rgba(78, 205, 196, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 30rpx;
  flex-shrink: 0;
}

.play-btn.stop {
  background: linear-gradient(135deg, #e0e0e0 0%, #cccccc 100%);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.12);
}

.play-btn:active {
  opacity: 0.85;
}

/* 播放三角形（CSS绘制） */
.icon-play {
  width: 0;
  height: 0;
  border-top: 24rpx solid transparent;
  border-bottom: 24rpx solid transparent;
  border-left: 38rpx solid white;
  margin-left: 10rpx;
}

/* 停止方块 */
.icon-stop {
  width: 42rpx;
  height: 42rpx;
  border-radius: 6rpx;
  background: white;
}
