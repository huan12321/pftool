.config-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
  box-sizing: border-box;
}
.config-header {
  margin-bottom: 30rpx;
}
.config-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}
.config-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
}
.slot-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.slot-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.slot-index {
  width: 50rpx;
  font-size: 28rpx;
  color: #999;
  font-weight: bold;
}
.slot-input {
  flex: 1;
  height: 72rpx;
  font-size: 30rpx;
  color: #333;
  background: #f8f8f8;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.slot-del {
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background: #ff4444;
  border-radius: 8rpx;
  margin-left: 16rpx;
}
.config-actions {
  margin-top: 40rpx;
}
.btn-add {
  background: #fff;
  color: #00aa66;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #00aa66;
}
.btn-save {
  background: #00aa66;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
}
